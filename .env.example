# Synccentric catalog API (https://app.synccentric.com)
SYNCCENTRIC_API_TOKEN=
SYNCCENTRIC_LOCALE=US

# Google Apps Script immutable ledger (Web App /exec URL + shared secret set in Script Properties)
GAS_LEDGER_URL=https://script.google.com/macros/s/XXXXXXXX/exec
GAS_LEDGER_SECRET=

# Notion internal integration token + TnkrBruja dev database (share the DB with the integration)
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Optional: skip the database lookup by pinning the data source directly
NOTION_DATA_SOURCE_ID=
